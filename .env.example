# Payload CMS — generate a long random string for production
PAYLOAD_SECRET=

# MongoDB (local Docker or Atlas)
DATABASE_URL=mongodb://127.0.0.1:27017/cooptech

# Public site URL (no trailing slash). Use the production domain on Vercel.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Mapbox public token (pk.*) for the contact page campus map
MAPBOX_TOKEN=

# Vercel Blob read/write token (auto-set when the store is connected to the Vercel project)
BLOB_READ_WRITE_TOKEN=
